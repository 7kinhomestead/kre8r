<div class="game-layout">
  <aside class="game-sidebar">
    <div class="sidebar-mod-header">
      <div>{{ category.title }}</div>
      <div class="sidebar-mod-title">{{ category.title }}</div>
    </div>
    <div class="sidebar-progress">
      <div class="sp-row">
        <span class="sp-label">Module Progress</span>
        <span class="sp-val">{{ category.completion.completed }} / {{ category.completion.total }}</span>
      </div>
      <div class="sp-bar">
        <div class="sp-fill" style="width:{{ category.completion.percent }}%"></div>
      </div>
    </div>
    <div class="sidebar-lessons">
      {% for lesson in category.posts %}
        <a href="{{ lesson.url }}" class="sl-item{% if lesson.completed? %} completed{% endif %}">
          <span class="sl-icon">{% if lesson.completed? %}✓{% else %}○{% endif %}</span>
          <span class="sl-name">{{ lesson.title }}</span>
        </a>
      {% endfor %}
    </div>
  </aside>
  <main class="game-main">
    <div class="game-breadcrumb">
      <a href="{{ current_product.url }}">🗺 Map</a>
      <span class="bc-sep">›</span>
      <span>{{ category.title }}</span>
    </div>
    <div style="padding:24px">
      {% section "category_body" %}
    </div>
  </main>
</div>
