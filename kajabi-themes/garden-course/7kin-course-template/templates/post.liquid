<div class="game-layout">

  <!-- Sidebar: module progress + lesson list -->
  <aside class="game-sidebar">
    <div class="sidebar-mod-header">
      <div>{{ post.category.title }}</div>
      <div class="sidebar-mod-title">{{ post.category.title }}</div>
    </div>
    <div class="sidebar-progress">
      <div class="sp-row">
        <span class="sp-label">Course Progress</span>
        <span class="sp-val">{{ current_product.completion.completed }} / {{ current_product.completion.total }}</span>
      </div>
      <div class="sp-bar">
        <div class="sp-fill" style="width:{{ current_product.completion.percent }}%"></div>
      </div>
    </div>
    <div class="sidebar-lessons">
      {% for category in current_product.categories %}
        <div class="sidebar-mod-divider">{{ category.title }}</div>
        {% for lesson in category.posts %}
          <a href="{{ lesson.url }}"
             data-post-id="{{ lesson.id }}"
             class="sl-item{% if lesson.id == post.id %} active{% elsif lesson.completed? %} completed{% endif %}">
            <span class="sl-icon">{% if lesson.completed? %}✓{% elsif lesson.id == post.id %}▶{% else %}○{% endif %}</span>
            <span class="sl-name">{{ lesson.title }}</span>
            {% if lesson.completed? %}<span class="sl-check">✓</span>{% endif %}
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </aside>

  <!-- Main lesson content -->
  <main class="game-main">

    <!-- Breadcrumb -->
    <div class="game-breadcrumb">
      <a href="{{ current_product.url }}">🗺 Map</a>
      <span class="bc-sep">›</span>
      <a href="{{ post.category.url }}">{{ post.category.title }}</a>
      <span class="bc-sep">›</span>
      <span>{{ post.title }}</span>
    </div>

    <!-- Video -->
    {% section "post_player" %}

    <!-- Lesson body -->
    <div class="game-lesson-body">
      <div class="lesson-module-tag">{{ post.category.title }}</div>
      <h1 class="lesson-title bb">{{ post.title }}</h1>

      <!-- Mark as complete -->
      {% section "post_body" %}

      <!-- Comments -->
      {% section "post_comments" %}


      <!-- Downloads -->
      {% if post.downloads.count > 0 %}
      <div style="margin:24px 0;background:var(--c1);border:1px solid var(--b1);border-radius:6px;padding:16px;">
        <div style="font-size:10px;font-weight:400;color:var(--t3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;">📎 Downloads</div>
        {% for download in post.downloads %}
          <a href="{{ download.url }}" style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--c2);border:1px solid var(--b1);border-radius:4px;margin-bottom:6px;text-decoration:none;color:var(--t1);transition:border-color .15s;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--b1)'">
            <span style="font-size:18px">
              {% if download.extension == '.pdf' %}📄
              {% elsif download.extension == '.doc' or download.extension == '.docx' %}📝
              {% elsif download.extension == '.xlsx' or download.extension == '.xls' %}📊
              {% elsif download.extension == '.pptx' or download.extension == '.ppt' %}📊
              {% elsif download.extension == '.zip' %}🗜️
              {% elsif download.extension == '.mp3' or download.extension == '.wav' %}🎵
              {% else %}📎{% endif %}
            </span>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13px;font-weight:500;color:var(--t1);">{{ download.display_name }}</div>
              <div style="font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;">{{ download.extension | remove: '.' }} · Click to download</div>
            </div>
            <span style="font-size:12px;color:var(--blue);">↓</span>
          </a>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Lesson nav -->
      <div class="lesson-nav">
        {% if post.previous %}
          <a href="{{ post.previous.url }}" class="ln-btn">← {{ post.previous.title | truncate: 30 }}</a>
        {% else %}
          <span></span>
        {% endif %}
        {% if post.next %}
          <a href="{{ post.next.url }}" class="ln-btn ln-btn-next">{{ post.next.title | truncate: 30 }} →</a>
        {% endif %}
      </div>
    </div>

  </main>
</div>

{% section "post_paywall" %}

{% comment %} Kre8r completion beacon — reports lesson_view + mark_complete to MissionΩr. Endpoint comes from the theme setting Kre8r Analytics → Completion Tracking Endpoint (window.RR_COURSE.trackEndpoint). {% endcomment %}
<script>
(function () {
  function initBeacon() {
  if (window.__kre8rBeaconLoaded) return;
  window.__kre8rBeaconLoaded = true;
  var C = window.RR_COURSE || {};
  var ENDPOINT = (C.trackEndpoint || window.KRE8R_BEACON_ENDPOINT || 'https://kre8r.app/api/kajabi-track');
  if (!ENDPOINT || ENDPOINT.indexOf('http') !== 0) return;
  var u = (window.Kajabi && window.Kajabi.currentSiteUser) || null;
  if (!u || (!u.contactId && !u.id)) return;
  var path = location.pathname;
  function grab(re){ var m = path.match(re); return m ? m[1] : null; }
  var post_id = grab(/\/posts\/(\d+)/);
  if (!post_id) return;
  var ctx = {
    product_slug: grab(/\/products\/([^/]+)/),
    category_id: grab(/\/categories\/(\d+)/),
    post_id: post_id
  };
  function lessonTitle(){
    var el = document.querySelector('.lesson-title, .post-title, main h1, h1');
    return el ? (el.textContent || '').replace(/\s+/g,' ').trim().slice(0,300) : (document.title||'').slice(0,300);
  }
  function send(event, progress){
    var payload = {
      contact_id: u.contactId || null,
      site_user_id: u.id || null,
      member_type: u.type || null,
      course_id: C.courseId || null,
      course_title: C.courseTitle || null,
      product_slug: ctx.product_slug,
      category_id: ctx.category_id,
      post_id: ctx.post_id,
      lesson_title: lessonTitle(),
      event: event,
      progress: (progress != null ? progress : null),
      url: location.href.slice(0,500)
    };
    var body = JSON.stringify(payload);
    try { if (navigator.sendBeacon) { navigator.sendBeacon(ENDPOINT, new Blob([body], { type:'text/plain' })); return; } } catch(e){}
    try { fetch(ENDPOINT, { method:'POST', body:body, headers:{'Content-Type':'text/plain'}, keepalive:true, mode:'no-cors' }); } catch(e){}
  }
  send('lesson_view');
  document.addEventListener('click', function(ev){
    var t = ev.target && ev.target.closest ? ev.target.closest('[data-post-completion-toggle], .mark-as-complete, .btn--completion') : null;
    if (t) send('mark_complete');
  }, true);
  try { window._wq = window._wq || []; window._wq.push({ id:'_all', onReady:function(v){ try{ v.bind('end', function(){ send('video_end', 100); }); }catch(e){} }}); } catch(e){}
  }
  // Wait for RR_COURSE (injected later in the page) before firing, so the endpoint resolves correctly.
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initBeacon); } else { initBeacon(); }
})();
</script>
