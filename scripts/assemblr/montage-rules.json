{
  "_doc": "Montage grammar config — machine copy of ROCK-RICH-BINDER/25-MONTAGE-GRAMMAR.md. Read by SlotΩr (build) and the montage critic (judge). Tuned for the Rock Rich audience: patient how-to niche, slow end of every band.",
  "shot": {
    "duration_band_s": [2.0, 4.0],
    "duration_floor_s": 1.0,
    "breath_shot_over_s": 4.0,
    "breath_shots_max_per_montage": 2,
    "adjacent_framing_min_change": "one_size_step_or_30deg"
  },
  "cadence": {
    "max_equal_length_run": 3,
    "variance_style": "clustered_1f_not_metronomic",
    "accelerate": "second_half_mean_lt_first_half_mean"
  },
  "repetition": {
    "max_same_action_instances": 3,
    "flag_on": 4
  },
  "narration": {
    "unnarrated_uncaptioned_warn_s": 30,
    "unnarrated_uncaptioned_flag_s": 45,
    "visual_change_min_interval_s": [5, 7],
    "pattern_interrupt_every_s": [30, 60]
  },
  "story": {
    "rehook_every_s": [120, 180],
    "rehook_position": "montage_end",
    "sag_zone_runtime_pct": [55, 65],
    "sag_zone_rule": "no_longest_montage_here",
    "bracket": "open_loop_before_result_after"
  },
  "payoff": {
    "speed": "1x_only",
    "voiceover": "forbidden",
    "music": "thin_or_drop"
  },
  "compression": {
    "in_task": "hard_cut",
    "across_scenes": "dissolve_allowed",
    "long_grind": "1x_intro_ramp_middle_1x_outcome",
    "time_markers": "environmental_not_graphic"
  },
  "audio_priority": ["natural_sound", "designed_sfx", "music_accent"],
  "music": {
    "one_cue_per_idea": true,
    "talking_beats": "l_cut_over_following_broll"
  },
  "faces": {
    "cut_in_at": ["pre_risk", "outcome"],
    "during_grind": "stay_on_work"
  },
  "act_profiles": {
    "_doc": "Jason's hierarchical-loop design (Jul 25): loop each act to plateau under its own profile, then join, then run the episode-level loop for structural sins (sag zone, re-hook spacing, cue variety, transitions, runtime). Profile keys off PipΩr beat map / emotional_function. Values override the base config above.",
    "act1_setup": {
      "goal": "world-building, information-dense, let the land speak",
      "shot": {"duration_band_s": [2.5, 5.0], "breath_shots_max_per_montage": 3},
      "music": {"presence": "restrained"}
    },
    "fun_and_games": {
      "goal": "delight, energy, comedy faces welcome",
      "shot": {"duration_band_s": [1.5, 3.0]},
      "faces": {"cut_in_at": ["pre_risk", "outcome", "comedy_beat"]},
      "music": {"presence": "forward"}
    },
    "act2_grind": {
      "goal": "effort and attrition, tension accumulating",
      "shot": {"duration_band_s": [2.0, 4.0]},
      "music": {"presence": "tension_bed"}
    },
    "act3_consequence": {
      "goal": "payoff and cost, tightest cutting, silence sacred",
      "shot": {"duration_band_s": [1.5, 3.5]},
      "narration": {"unnarrated_uncaptioned_warn_s": 45, "unnarrated_uncaptioned_flag_s": 60},
      "music": {"presence": "drops_at_peaks"}
    }
  },
  "loop_hierarchy": {
    "_doc": "Local judges converge per-act (cheap, parallel, nothing hides in an average — the EP0 bed-check lesson). Structural judges run once per episode join.",
    "local_unit": "act",
    "local_judges": ["montage_laws", "loudness_bed", "hook_cadence", "grammar_profile"],
    "structural_judges": ["sag_zone_placement", "rehook_spacing", "cue_variety", "act_transitions", "total_runtime"]
  },
  "meta": {
    "uncertain_trim_bias": "longer",
    "every_cut_needs_reason": ["new_info", "on_action", "scale_change", "beat", "progress_step"],
    "required_ingest_tags": ["action_class", "shot_scale", "effort_direction", "progress_stage"]
  }
}
